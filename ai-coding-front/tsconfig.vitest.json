// TSConfig for test files, which run in Node.js (readFileSync / SSR renderToString).
{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/**/__tests__/*", "src/**/*.spec.ts"],
  "exclude": [],
  "compilerOptions": {
    // Tests import from `node:fs`, so Node.js types are needed on top of the DOM lib.
    "types": ["node"],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
